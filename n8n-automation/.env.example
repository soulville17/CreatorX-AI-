# ============================================================
# Automatisation marketing n8n — variables d'environnement
# Copie ce fichier en `.env` (dans le dossier n8n-automation/)
# puis remplis les valeurs. docker compose les lit automatiquement.
# ============================================================

# ---------- Base de données Postgres ----------
POSTGRES_USER=creatorx
POSTGRES_PASSWORD=mets-un-vrai-mot-de-passe-ici
POSTGRES_DB=marketing

# ---------- n8n ----------
# En local, laisse tel quel. Sur un serveur, mets ton domaine (ex : https://n8n.tondomaine.com/)
N8N_HOST=localhost
WEBHOOK_URL=http://localhost:5678/

# ---------- IA (Claude) — analyse produit + copywriting ----------
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-haiku-4-5-20251001

# ---------- Meta (Facebook) — publication sur ta Page ----------
# Voir README section "Configurer la Meta Graph API"
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=

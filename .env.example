# ============================================================
# CreatorX AI — Variables d'environnement
# Copie ce fichier en `.env` et remplis les valeurs.
# Les variables VITE_* sont exposées au navigateur (jamais de secrets !).
# Les autres sont des secrets à configurer dans Supabase Edge Functions :
#   supabase secrets set NOM_VARIABLE=valeur
# ============================================================

# ---------- Frontend (Vite) — valeurs PUBLIQUES uniquement ----------
# URL de ton projet Supabase (Dashboard → Settings → API)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clé publique "anon" de Supabase (protégée par le RLS, sans danger côté client)
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# ---------- Secrets Supabase Edge Functions (jamais côté client) ----------
# Clé API Anthropic (Claude) — textes, analyses, briefs, modération
ANTHROPIC_API_KEY=sk-ant-...
# Modèles Claude : Haiku pour les tâches simples, Sonnet pour les briefs complexes
CLAUDE_MODEL_SIMPLE=claude-haiku-4-5-20251001
CLAUDE_MODEL_COMPLEXE=claude-sonnet-5

# Clé API fal.ai — génération d'images (FLUX) et de vidéos (Kling / Wan)
FAL_API_KEY=fal-...
# Modèle vidéo : "kling" (défaut, qualité) ou "wan" (économique)
VIDEO_MODEL=kling
# Modèles images : brouillon (économique) et final (qualité)
IMAGE_MODEL_DRAFT=fal-ai/flux/schnell
IMAGE_MODEL_FINAL=fal-ai/flux-pro

# Clé API ElevenLabs — voix off françaises
ELEVENLABS_API_KEY=...

# ---------- CinetPay (paiement mobile money : Wave / Orange Money / MTN / Moov) ----------
# Mode "sandbox" par défaut. Passe à "production" quand ton compte est validé.
CINETPAY_MODE=sandbox
CINETPAY_API_KEY=...
CINETPAY_SITE_ID=...
# Clé secrète utilisée pour vérifier la signature (HMAC) des webhooks
CINETPAY_SECRET_KEY=...

# URL publique du site (pour les redirections après paiement)
SITE_URL=http://localhost:5173

# ---------- Meta (Phase 2 — automatisation des campagnes) ----------
# Laisser vide en phase 1 : les campagnes sont lancées manuellement par l'admin.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_PAGE_ID=
